generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Model {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SectionTD {
  id           Int         @id @default(autoincrement())
  type         SectionType @unique
  titlePartOne String
  titlePartTwo String?
  description  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model HeroSection {
  id         Int         @id @default(autoincrement())
  mediaType  String
  videoUrl   String?
  videoTitle String?
  videoDesc  String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  images     HeroImage[]
}

model AboutUs {
  id           Int           @id @default(autoincrement())
  titlePartOne String        @db.VarChar(50)
  titlePartTwo String?       @db.VarChar(50)
  description  String
  image        String
  imageAlt     String?       @default("Eventify Banner Image")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  cards        AboutUsCard[]
}

model AboutUsCard {
  id               Int      @id @default(autoincrement())
  backFace         String
  sortOrder        Int
  aboutUsId        Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  frontFacePartOne String?
  frontFacePartTwo String?
  aboutUs          AboutUs  @relation(fields: [aboutUsId], references: [id], onDelete: Cascade)
}

model HeroImage {
  id          Int         @id @default(autoincrement())
  heroId      Int
  imageUrl    String
  altText     String?
  title       String?
  description String?
  isActive    Boolean     @default(false)
  order       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  hero        HeroSection @relation(fields: [heroId], references: [id], onDelete: Cascade)

  @@index([heroId])
}

model Clients {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  image       String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  order       Int       @default(0)
  projects    Project[]
}

model Project {
  id                Int             @id @default(autoincrement())
  title             String
  description       String?
  bannerImage       String
  images            String[]
  categoryId        Int
  hasTabs           Boolean         @default(false)
  clientId          Int?
  createdAt         DateTime        @default(now())
  projectClientLogo String?
  updatedAt         DateTime        @default(now()) @updatedAt
  order             Int             @default(0)
  category          ProjectCategory @relation(fields: [categoryId], references: [id])
  client            Clients?        @relation(fields: [clientId], references: [id])
  tabs              ProjectTab[]

  @@index([categoryId])
  @@index([clientId])
}

model ProjectTab {
  id        Int      @id @default(autoincrement())
  name      String
  images    String[]
  order     Int      @default(0)
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectCategory {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  project     Project[]
}

model Author {
  id     Int     @id @default(autoincrement())
  name   String
  bio    String?
  email  String  @unique
  avatar String?
  role   String  @default("Author")
  blogs  Blog[]
}

model BlogCategory {
  id          Int     @id @default(autoincrement())
  name        String  @default("Activations")
  description String?
  blogs       Blog[]
}

model Blog {
  id              Int          @id @default(autoincrement())
  title           String       @db.VarChar(100)
  slug            String       @unique @db.VarChar(100)
  description     String       @db.VarChar(160)
  content         String
  metaTitle       String       @db.VarChar(60)
  keywords        String[]
  thumbnail       String
  banner_image    String
  canonical       String
  timeToRead      String?      @default("5 min read")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  authorId        Int
  categoryId      Int
  schemaScript    String
  metaDescription String       @db.VarChar(160)
  publishedAt     DateTime?
  status          BlogStatus   @default(DRAFT)
  bannerImageAlt  String?
  thumbnailAlt    String?
  lastViewedAt    DateTime?
  viewCount       Int          @default(0)
  author          Author       @relation(fields: [authorId], references: [id])
  category        BlogCategory @relation(fields: [categoryId], references: [id])
  views           BlogView[]

  @@index([authorId])
  @@index([categoryId])
  @@index([status])
  @@index([viewCount])
}

model BlogView {
  id        Int      @id @default(autoincrement())
  blogId    Int
  userIp    String?
  userAgent String?
  viewedAt  DateTime @default(now())
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@index([blogId])
  @@index([viewedAt])
}

model User {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  email     String   @unique
  password  String
  role      UserRole @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactSubmission {
  id          Int                     @id @default(autoincrement())
  name        String
  email       String
  phone       String
  message     String
  status      ContactSubmissionStatus @default(NEW)
  submittedAt DateTime                @default(now())
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([status])
  @@index([submittedAt])
}

model Service {
  id             Int              @id @default(autoincrement())
  title          String
  url            String           @unique
  description    String
  content        String
  image          String
  bannerImage    String?
  order          Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  service_images service_images[]

  @@map("services")
}

model Award {
  id         Int             @id @default(autoincrement())
  year       Int             @unique
  order      Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  categories AwardCategory[]

  @@index([year])
}

model AwardCategory {
  id      Int          @id @default(autoincrement())
  name    String
  icon    String
  iconAlt String
  order   Int          @default(0)
  awardId Int
  award   Award        @relation(fields: [awardId], references: [id], onDelete: Cascade)
  images  AwardImage[]

  @@index([awardId])
}

model AwardImage {
  id          Int           @id @default(autoincrement())
  url         String
  imageAlt    String        @default("")
  title       String
  description String        @default("")
  order       Int           @default(0)
  categoryId  Int
  category    AwardCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

model Comparison {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  beforeImage String
  afterImage  String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

model TeamMember {
  id         Int              @id @default(autoincrement())
  name       String
  role       String
  image      String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  gridLayout TeamsGridLayout?
}

model TeamsGridLayout {
  id           Int        @id @default(autoincrement())
  x            Int
  y            Int
  width        Int
  height       Int
  teamMemberId Int        @unique
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@unique([x, y])
}

model NewsletterSubscriber {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  subscribedAt     DateTime  @default(now())
  unsubscribeToken String    @unique @default(cuid())
  unsubscribedAt   DateTime?
  isActive         Boolean   @default(true)

  @@index([email])
  @@index([isActive])
}

model NewsletterSend {
  id             Int      @id @default(autoincrement())
  subject        String
  templateId     String
  templateData   Json
  sentAt         DateTime @default(now())
  recipientCount Int      @default(0)
}

model InstagramPost {
  id          Int      @id @default(autoincrement())
  url         String   @unique
  image       String?
  title       String?
  isEnabled   Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  imageHeight Int?
  imageWidth  Int?
}

model service_images {
  id        Int     @id @default(autoincrement())
  serviceId Int
  image     String
  title     String?
  order     Int     @default(0)
  services  Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

enum SectionType {
  CLIENT
  SERVICE
  TEAM
  PROJECT
  AWARD
  BLOG
  SYL
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContactSubmissionStatus {
  NEW
  READ
}
