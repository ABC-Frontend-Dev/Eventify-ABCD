generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Model {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SectionType {
CLIENT
SERVICE
TEAM
PROJECT
AWARD
BLOG
SYL //See You Later
}

model SectionTD {
id Int @id @default(autoincrement())
type SectionType @unique
titlePartOne String
titlePartTwo String?
description String? @db.Text
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
}

model HeroSection {
  id           Int      @id @default(autoincrement())
  mediaType    String   // "video" or "image"

  // Video fields
  videoUrl     String?
  videoTitle   String?
  videoDesc    String?

  // Image fields (multiple)
  images       HeroImage[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AboutUs {
  id           Int           @id @default(autoincrement())

  titlePartOne String        @db.VarChar(50)
  titlePartTwo String?       @db.VarChar(50)

  description  String        @db.Text

  image         String       @db.Text
  imageAlt      String?      @default("Eventify Banner Image")

  cards         AboutUsCard[]

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model AboutUsCard {
  id          Int      @id @default(autoincrement())

  frontFace   String   @db.Text
  backFace    String   @db.Text
  sortOrder   Int

  aboutUsId   Int
  aboutUs     AboutUs  @relation(fields: [aboutUsId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HeroImage {
  id           Int      @id @default(autoincrement())
  heroId       Int
  hero         HeroSection @relation(fields: [heroId], references: [id], onDelete: Cascade)

  imageUrl     String
  altText      String?
  title        String?
  description  String?
  isActive     Boolean  @default(false)
  order        Int      @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([heroId])
}

model Clients {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  image       String
  order       Int       @default(0)
  projects    Project[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt 
}

model Project {
  id                Int             @id @default(autoincrement())
  title             String
  description       String?
  bannerImage       String
  images            String[]
  categoryId        Int
  order             Int             @default(0)
  hasTabs           Boolean         @default(false)
  clientId          Int?            
  projectClientLogo String?         
  category          ProjectCategory @relation(fields: [categoryId], references: [id])
  client            Clients?        @relation(fields: [clientId], references: [id])
  tabs              ProjectTab[]
  createdAt         DateTime        @default(now())
  
  // FIX: Add @default(now()) so existing 23 rows get filled with the current time
  updatedAt         DateTime        @default(now()) @updatedAt

  @@index([categoryId])
  @@index([clientId])
}

model ProjectTab {
  id        Int      @id @default(autoincrement())
  name      String
  images    String[]
  order     Int      @default(0)
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectCategory {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  project     Project[]
}

model Author {
  id     Int     @id @default(autoincrement())
  name   String
  bio    String?
  email  String  @unique
  avatar String?
  blogs  Blog[]
}

model BlogCategory {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  blogs       Blog[]
}

model Blog {
  id              Int          @id @default(autoincrement())
  title           String       @db.VarChar(100)
  slug            String       @unique @db.VarChar(100)
  description     String       @db.VarChar(160)
  content         String
  metaTitle       String       @db.VarChar(60)
  keywords        String[]
  thumbnail       String
  banner_image    String
  canonical       String
  timeToRead      String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  authorId        Int
  categoryId      Int
  schemaScript    String
  metaDescription String       @db.VarChar(160)
  publishedAt     DateTime?
  status          BlogStatus   @default(DRAFT)
  bannerImageAlt  String?
  thumbnailAlt    String?
  lastViewedAt    DateTime?
  viewCount       Int          @default(0)
  author          Author       @relation(fields: [authorId], references: [id])
  category        BlogCategory @relation(fields: [categoryId], references: [id])
  views           BlogView[]

  @@index([authorId])
  @@index([categoryId])
  @@index([status])
  @@index([viewCount])
}

model BlogView {
  id        Int      @id @default(autoincrement())
  blogId    Int
  userIp    String?
  userAgent String?
  viewedAt  DateTime @default(now())
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@index([blogId])
  @@index([viewedAt])
}

model User {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactSubmission {
  id          Int                     @id @default(autoincrement())
  name        String
  email       String
  phone       String
  message     String
  status      ContactSubmissionStatus @default(NEW)
  submittedAt DateTime                @default(now())
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([status])
  @@index([submittedAt])
}

model Service {
  id          Int            @id @default(autoincrement())
  title       String
  url         String         @unique
  description String
  content     String
  image       String
  bannerImage String?
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  images      ServiceImage[]

  @@map("services")
}

model ServiceImage {
  id        Int     @id @default(autoincrement())
  serviceId Int
  image     String
  title     String?
  order     Int     @default(0)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("service_images")
}

model Award {
  id         Int             @id @default(autoincrement())
  year       Int             @unique
  order      Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  categories AwardCategory[]

  @@index([year])
}

model AwardCategory {
  id                 Int                  @id @default(autoincrement())
  name               String
  icon               String
  iconAlt            String
  order              Int                  @default(0)
  gradientWidthClass String               @default("w-4/5")
  awardId            Int
  carouselImages     AwardCarouselImage[]
  award              Award                @relation(fields: [awardId], references: [id], onDelete: Cascade)
  items              AwardItem[]

  @@index([awardId])
}

model AwardCarouselImage {
  id         Int           @id @default(autoincrement())
  url        String
  order      Int           @default(0)
  categoryId Int
  category   AwardCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

model AwardItem {
  id          Int           @id @default(autoincrement())
  title       String
  description String
  order       Int           @default(0)
  categoryId  Int
  category    AwardCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

model Comparison {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  beforeImage String
  afterImage  String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

model TeamMember {
  id        Int      @id @default(autoincrement())
  position  Int      @unique
  name      String
  role      String
  image     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContactSubmissionStatus {
  NEW
  READ
}
